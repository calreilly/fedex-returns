WAREHOUSE_PHONE=
WAREHOUSE_STREET=
WAREHOUSE_CITY=
WAREHOUSE_STATE=
WAREHOUSE_ZIP=

BOX_WEIGHT_LB=10
BOX_LENGTH_IN=12
BOX_WIDTH_IN=12
BOX_HEIGHT_IN=12
