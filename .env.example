# Copy to .env and fill in. Never commit .env.
FEDEX_ENV=sandbox
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_SERVICE_TYPE=FEDEX_GROUND
